{
  "name": "auto-audio-input-switcher",
  "version": "0.2.0",
  "description": "Automatyczne przełączanie domyślnego mikrofonu w Windows wg obecności użytkownika (mmWave USB radar + Electron Tray)",
  "main": "out/main/index.js",
  "author": "Monratis",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe') { & 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe' /nologo /optimize /out:bin\\AudioSwitcher.exe src\\native\\AudioSwitcher.cs } else { csc /nologo /optimize /out:bin\\AudioSwitcher.exe src\\native\\AudioSwitcher.cs }\"",
    "build": "npm run build:native && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package:app": "node scripts/build.mjs app",
    "package:installer": "node scripts/build.mjs installer",
    "package:win": "node scripts/build.mjs app",
    "package:all": "node scripts/build.mjs all",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "iconv-lite": "^0.7.3",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.monratis.autoaudio",
    "productName": "Auto Audio Switch",
    "npmRebuild": false,
    "compression": "normal",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "asarUnpack": [
      "node_modules/@serialport/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName} (Portable).exe"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

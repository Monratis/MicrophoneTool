{
  "name": "desksense",
  "version": "0.3.5",
  "description": "DeskSense — inteligentne automatyczne przełączanie mikrofonu wg obecności przy biurku (mmWave USB radar + Electron Tray)",
  "main": "out/main/index.js",
  "author": "Monra",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$csc = if (Test-Path 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe') { 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe' } else { 'csc' }; & $csc /nologo /optimize /out:bin\\AudioSwitcher.exe src\\native\\AudioSwitcher.cs; & $csc /nologo /optimize /platform:x64 /out:bin\\VoiceListener.exe src\\native\\VoiceListener.cs; & $csc /nologo /optimize /platform:anycpu /out:bin\\GlobalInputHook.exe src\\native\\GlobalInputHook.cs\"",
    "build": "npm run build:native && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package:app": "node scripts/build.mjs app",
    "package:portable": "node scripts/build.mjs portable",
    "package:installer": "node scripts/build.mjs installer",
    "package:win": "node scripts/build.mjs all",
    "package:all": "node scripts/build.mjs all",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "esptool-js": "^0.6.1",
    "iconv-lite": "^0.7.3",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "rcedit": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.monratis.desksense",
    "productName": "DeskSense",
    "npmRebuild": false,
    "compression": "normal",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "asarUnpack": [
      "node_modules/@serialport/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName} (Portable).exe",
      "unpackDirName": "DeskSense",
      "useZip": false
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
